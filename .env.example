# Copia este archivo como ".env" y llena tus datos. NUNCA subas .env a GitHub.

# --- Panel (obligatorio) ---
PANEL_PASSWORD=cambia-esta-clave-larga
# Token para que Make/n8n/Zapier envíen publicaciones a /api/ingest (opcional)
INGEST_TOKEN=

# --- Telegram (recomendado: es el canal más sencillo) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# --- WhatsApp Cloud API de Meta (opcional) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TO=521XXXXXXXXXX
# Solo si usas plantilla aprobada con 1 variable en el cuerpo:
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=es_MX

# --- Otros ---
PORT=8080
DB_PATH=data/alertas.db
RSS_MINUTES=10
TZ_OFFSET=-6
# Pon COOKIE_SECURE=1 y TRUST_PROXY=1 cuando lo sirvas detrás de HTTPS (Railway, Render, Nginx)
COOKIE_SECURE=0
TRUST_PROXY=0
# DRY_RUN=1 imprime las alertas en el log en vez de enviarlas (para probar)
DRY_RUN=0
